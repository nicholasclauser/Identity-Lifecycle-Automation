# ===========================================================================
# Identity Lifecycle Automation - environment config
# Copy this file to '.env' and fill in your environment values.
# Never commit the real .env. See .gitignore.
# ===========================================================================

# --- Get-ADLifecycleReport.ps1 ---

# Output destination for generated reports.
OUTPUT_DIR=C:\path\to\reports

# AD search base. Leave empty to default to the domain root.
BASE_DN=DC=corp,DC=example,DC=com

# If true, every run creates a timestamped subfolder (yyyyMMdd-HHmm).
TIMESTAMPED=true

# Console preview row count per category.
MAX_PREVIEW=5

# Regex matching the email suffix for vendor/third-party accounts to auto-exclude.
# Example: @(vendor1\.com|vendor2\.ca)$
VENDOR_EXCLUDE_DOMAINS=

# Path to a file containing DisplayName auto-exclude regex patterns (one per line).
# See autoexclude-patterns.template.txt for the expected format.
# If unset, the script looks for ./autoexclude-patterns.txt next to itself.
AUTOEXCLUDE_PATTERNS_FILE=

# Regex pattern for VIP / executive SamAccountNames to auto-exclude from the report.
VIP_ACCOUNT_PATTERN=

# Optional whitelist path (plain-text file, one SamAccountName per line).
# Auto-detects ./whitelist.txt if unset.
WHITELIST_PATH=

# --- SharePoint upload (Get-ADLifecycleReport.ps1) ---
# All four required for unattended cert-based upload. Omit Thumbprint for interactive login.
SharePointSiteUrl=https://yourtenant.sharepoint.com/sites/YourSite
SharePointFolder=AD-Lifecycle
SharePointClientId=
SharePointTenantId=
SharePointThumbprint=

# --- Offboard.ps1 ---

# Name (not DN) of the OU to move disabled accounts into.
DISABLED_OU_NAME=Disabled_Users

# Regex pattern of surnames that require higher-tier approval before offboarding.
# Leave empty to disable the check. Example: ^(Doe|Smith)$
SENSITIVE_SURNAMES=
